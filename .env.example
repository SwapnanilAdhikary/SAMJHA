# Copy to .env and fill in. .env is gitignored — never commit a real key.

# Rime TTS. Free, self-serve, no credit card: https://app.rime.ai/signup
# ~800k characters free, includes Coda and the /ws3 websocket.
RIME_API_KEY=

# Sarvam AI — Hindi/Hinglish STT (saaras:v4). Day 2. https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Deepgram — fallback STT (nova-3, language=hi). Day 2. https://console.deepgram.com
DEEPGRAM_API_KEY=

# LiveKit Cloud — browser call transport. Day 2. https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM for clause explanation + teach-back grading. Day 2.
# OpenRouter has a first-class factory in livekit-plugins-openai 1.8.0:
#   openai.LLM.with_openrouter(model=..., fallback_models=[...])
# fallback_models is worth real money during judging: if a provider rate-limits
# mid-demo, OpenRouter routes to the next model instead of dropping the call.
# NOTE: OpenRouter is prepaid credits, not a free tier. The ':free' model variants
# are rate-limited and not demo-safe. Budget a few dollars.
OPENROUTER_API_KEY=

# Alternative: Google AI Studio has a genuinely free tier (no billing account) and
# strong Hindi. Cheaper, but no fallback routing.
GOOGLE_API_KEY=
